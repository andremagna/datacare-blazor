@page "/logs"
@using DataCare.Models
@using DataCare.Services
@using Microsoft.Data.SqlClient
@inject EtlStateService State
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>DataCare – Tasks</PageTitle>

@if (_loading)
{
    <div class="logs-empty">
        <div class="dash-empty-icon">
            <svg viewBox="0 0 64 64" fill="none" width="48" height="48">
                <circle cx="32" cy="32" r="28" stroke="#1a3a6b" stroke-width="3" opacity=".4"/>
                <path d="M32 16v16l10 6" stroke="#4a90d9" stroke-width="3" stroke-linecap="round"/>
            </svg>
        </div>
        <p class="dash-empty-msg">Loading logs...</p>
    </div>
}
else if (!_hasData)
{
    <div class="logs-empty">
        <div class="dash-empty-icon">
            <svg viewBox="0 0 64 64" fill="none" width="56" height="56">
                <rect x="8" y="8" width="48" height="48" rx="6" stroke="#1a3a6b" stroke-width="2.5" opacity=".4"/>
                <line x1="18" y1="24" x2="46" y2="24" stroke="#4a90d9" stroke-width="2" stroke-linecap="round"/>
                <line x1="18" y1="33" x2="38" y2="33" stroke="#4a90d9" stroke-width="2" stroke-linecap="round" opacity=".5"/>
                <line x1="18" y1="42" x2="30" y2="42" stroke="#4a90d9" stroke-width="2" stroke-linecap="round" opacity=".25"/>
            </svg>
        </div>
        <h2 class="dash-empty-title">No logs available</h2>
        <p class="dash-empty-msg">Run the <strong>ETL</strong> from the <a href="/">Home</a> page, or configure the SQL connection on the <a href="/environment">Environment Configuration</a> page to view logs.</p>
    </div>
}
else
{
    <div class="logs-page">
        <div class="dash-header">
            <div>
                <h1 class="dash-title">Execution Tasks</h1>
                <span class="dash-sub">dbo.ExecutionLog — all executions</span>
            </div>
            <div class="logs-filter-row">
                <input class="logs-search"
                   type="text"
                   placeholder="Search by ExecutionId, ReportName, Status…"
                   @bind="_search"
                   @bind:event="oninput"
                   @bind:after="() => _page = 1" />
            </div>
        </div>

        <div class="env-table-wrap">
            <table class="env-table">
                <thead>
                    <tr>
                        <th @onclick="@(() => SortBy("ExecutionId"))" class="sortable @(SortClass("ExecutionId"))">Execution ID</th>
                        <th @onclick="@(() => SortBy("ExecutionDate"))" class="sortable @(SortClass("ExecutionDate"))">Date</th>
                        <th @onclick="@(() => SortBy("ReportName"))" class="sortable @(SortClass("ReportName"))">Report</th>
                        <th @onclick="@(() => SortBy("Status"))" class="sortable @(SortClass("Status"))">Status</th>
                        <th @onclick="@(() => SortBy("RowsRetrieved"))" class="sortable @(SortClass("RowsRetrieved"))">Retrieved</th>
                        <th @onclick="@(() => SortBy("RowsInserted"))" class="sortable @(SortClass("RowsInserted"))">Inserted</th>
                        <th @onclick="@(() => SortBy("DurationTimeJob"))" class="sortable @(SortClass("DurationTimeJob"))">Duration</th>
                        <th @onclick="@(() => SortBy("TableSizeMB"))" class="sortable @(SortClass("TableSizeMB"))">Size (MB)</th>
                        <th>Error</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in PagedRows())
                    {
                        <tr class="@(r.IsSuccess ? "" : "log-row-err")">
                            <td class="log-execid">
                                @if (r.ExecutionId.HasValue)
                                {
                                    <span class="execid-short" title="@r.ExecutionId.Value.ToString("D")">@(r.ExecutionId.Value.ToString("D")[..8])…</span>
                                    <button class="copy-btn" title="Copy ExecutionId"
                                            @onclick="@(() => CopyToClipboard(r.ExecutionId!.Value.ToString("D")))">
                                        @if (_copiedId == r.ExecutionId.Value)
                                        {
                                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#4caf90" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                                        }
                                        else
                                        {
                                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#4a7aaa" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                                        }
                                    </button>
                                }
                                else { <span style="color:#334">—</span> }
                            </td>
                            <td class="log-date">@r.ExecutionDate.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td>@r.ReportName</td>
                            <td>
                                <span class="log-badge @(r.IsSuccess ? "badge-ok" : r.Status == "CANCELLED" ? "badge-warn" : "badge-err")">
                                    @r.Status
                                </span>
                            </td>
                            <td class="log-num">@r.RowsRetrieved.ToString("N0")</td>
                            <td class="log-num">@r.RowsInserted.ToString("N0")</td>
                            <td class="log-duration">@(string.IsNullOrWhiteSpace(r.DurationTimeJob) ? "—" : r.DurationTimeJob)</td>
                            <td class="log-num log-size">@(r.TableSizeMB.HasValue ? r.TableSizeMB.Value.ToString("F2") : "—")</td>
                            <td class="log-err">@(r.ErrorMessage ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
            <div class="logs-footer">
                <span>@_all.Count totali &nbsp;·&nbsp; @Filtered().Count() filtrati &nbsp;·&nbsp; Pagina @_page di @TotalPages</span>
                <div class="pagination">
                    <button class="pg-btn" @onclick="PrevPage" disabled="@(_page <= 1)">‹ Prec</button>
                    @for (int p = 1; p <= TotalPages; p++)
                    {
                        var pCopy = p;
                        <button class="pg-btn @(pCopy == _page ? "pg-active" : "")" @onclick="@(() => GoToPage(pCopy))">@pCopy</button>
                    }
                    <button class="pg-btn" @onclick="NextPage" disabled="@(_page >= TotalPages)">Succ ›</button>
                </div>
            </div>
        </div>
}

<style>
.logs-page { padding: 1.5rem 2rem; }
.logs-empty { display:flex; flex-direction:column; align-items:center; justify-content:center;
              min-height:55vh; gap:1rem; text-align:center; }
.logs-filter-row { display:flex; gap:.75rem; align-items:center; }

/* Search input con bordo evidenziato */
.logs-search {
    background: #10101f;
    border: 1.5px solid #2a3a5a;
    color: #c8d0e7;
    border-radius: 7px;
    padding: .42rem .85rem;
    font-size: .82rem;
    width: 300px;
    outline: none;
    transition: border-color .18s, box-shadow .18s;
}
.logs-search::placeholder { color: #445; }
.logs-search:focus {
    border-color: #1B8FFF;
    box-shadow: 0 0 0 3px rgba(27,143,255,.18);
}

/* Stessa struttura di env-table-wrap/env-table (EnvironmentConfiguration) */
.env-table-wrap { overflow-x:auto; border-radius:10px; border:1px solid #1e1e38; background:#10101f; }
.env-table { width:100%; border-collapse:collapse; font-size:.82rem; }
.env-table thead tr { background:#151528; }
.env-table th { padding:.65rem .9rem; color:#7090c0; font-weight:600; text-align:left;
                border-bottom:1px solid #1e1e38; white-space:nowrap; user-select:none; }
.env-table th.sortable { cursor:pointer; }
.env-table th.sortable:hover { color:#a0c0f0; }
.env-table th.sort-asc::after  { content:" ▲"; font-size:.7em; }
.env-table th.sort-desc::after { content:" ▼"; font-size:.7em; }
.env-table td { padding:.6rem .9rem; border-bottom:1px solid #1a1a30; color:#b0bcd4; vertical-align:middle; }
.env-table tr:last-child td { border-bottom:none; }
.env-table tr:hover td { background:#13132a; }
.log-row-err td { background:#1a0f0f; }
.log-row-err:hover td { background:#1f1010; }

.log-execid { font-family:monospace; font-size:.75rem; color:#5a7fa0; white-space:nowrap;
              display:flex; align-items:center; gap:.3rem; }
.execid-short { cursor:default; }
.copy-btn { background:none; border:none; padding:0; cursor:pointer;
            display:inline-flex; align-items:center; justify-content:center;
            width:20px; height:20px; border-radius:4px;
            opacity:0.5; transition:opacity .15s, background .15s; flex-shrink:0; }
.copy-btn:hover { opacity:1; background:#1e2540; }
.log-date     { white-space:nowrap; color:#778; font-family:monospace; }
.log-num      { text-align:right; font-family:monospace; }
.log-err      { color:#e07070; font-size:.78rem; max-width:280px; word-break:break-word; }
.log-duration { font-family:monospace; letter-spacing:.04em; color:#7ab8e0; }
.log-size     { color:#7dc97d; font-family:monospace; }
.log-badge { display:inline-block; padding:.15rem .55rem; border-radius:4px;
             font-size:.75rem; font-weight:700; letter-spacing:.03em; }
.badge-ok   { background:#0e3322; color:#4caf90; }
.badge-err  { background:#3a0f0f; color:#e07070; }
.badge-warn { background:#2a200a; color:#e0b050; }

/* ── Footer & paginazione ───────────────────── */
.logs-footer { padding:.6rem 1rem; border-top:1px solid #1e1e38;
               display:flex; align-items:center; justify-content:space-between;
               flex-wrap:wrap; gap:.5rem; }
.logs-footer span { color:#445; font-size:.75rem; }
.pagination { display:flex; gap:.3rem; flex-wrap:wrap; align-items:center; }
.pg-btn { background:#151528; border:1px solid #1e1e38; color:#556;
          border-radius:5px; padding:.22rem .6rem;
          font-size:.75rem; cursor:pointer; transition:background .15s, color .15s; min-width:28px; }
.pg-btn:hover:not(:disabled) { background:#1e2a44; color:#a0c0f0; }
.pg-btn:disabled { opacity:.35; cursor:not-allowed; }
.pg-btn.pg-active { background:#1b3464; color:#4a90d9;
                    border-color:#4a90d9; font-weight:700; }
</style>

@code {
    private List<ExecutionLogEntry> _all = new();
    private bool _loading = true;
    private bool _hasData = false;
    private string _search = string.Empty;
    private string _sortCol = "ExecutionDate";
    private bool _sortDesc = true;
    private Guid? _copiedId = null;

    // ── Paginazione ──────────────────────────────────
    private const int PageSize = 20;
    private int _page = 1;
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(Filtered().Count() / (double)PageSize));
    private IEnumerable<ExecutionLogEntry> PagedRows() => Filtered().Skip((_page - 1) * PageSize).Take(PageSize);
    private void GoToPage(int p) { _page = Math.Clamp(p, 1, TotalPages); }
    private void PrevPage()      => GoToPage(_page - 1);
    private void NextPage()      => GoToPage(_page + 1);

    protected override async Task OnInitializedAsync()
    {
        State.OnChanged += OnStateChanged;
        await LoadLogsAsync();
    }

    private async Task LoadLogsAsync()
    {
        _loading = true;
        try
        {
            var cs = State.LastConnectionString;
            if (string.IsNullOrWhiteSpace(cs))
            {
                _hasData = false;
                return;
            }
            var list = new List<ExecutionLogEntry>();

            // Verifica che il DB esista su master prima di tentare la connessione al target
            var masterCs = new SqlConnectionStringBuilder(cs) { InitialCatalog = "master" }.ConnectionString;
            await using (var masterConn = new SqlConnection(masterCs))
            {
                await masterConn.OpenAsync();
                var dbName = new SqlConnectionStringBuilder(cs).InitialCatalog;
                await using var chk = new SqlCommand(
                    "SELECT COUNT(*) FROM sys.databases WHERE name=@n", masterConn);
                chk.Parameters.AddWithValue("@n", dbName);
                if ((int)(await chk.ExecuteScalarAsync())! == 0)
                {
                    _hasData = false;
                    return;
                }
            }

            await using var conn = new SqlConnection(cs);
            await conn.OpenAsync();

            // Rileva schema: DurationTimeJob (nuovo) o DurationSeconds (vecchio)
            bool hasDurCol  = await ColumnExistsAsync(conn, "ExecutionLog", "DurationTimeJob");
            bool hasSizeCol = await ColumnExistsAsync(conn, "ExecutionLog", "TableSizeMB");

            string durationExpr = hasDurCol
                ? "DurationTimeJob"
                : @"CASE WHEN DurationSeconds IS NULL THEN NULL
                         ELSE RIGHT('00'+CAST(DurationSeconds/3600 AS NVARCHAR),2)+':'+
                              RIGHT('00'+CAST((DurationSeconds%3600)/60 AS NVARCHAR),2)+':'+
                              RIGHT('00'+CAST(DurationSeconds%60 AS NVARCHAR),2) END";
            string sizeExpr = hasSizeCol ? "TableSizeMB" : "NULL";

            await using var cmd = new SqlCommand($@"
                SELECT ExecutionId, ExecutionDate, ReportName, Status,
                       RowsRetrieved, RowsInserted,
                       {durationExpr} AS Duration,
                       ErrorMessage,
                       {sizeExpr} AS TableSizeMB
                FROM dbo.ExecutionLog
                ORDER BY ExecutionDate DESC", conn);

            await using var rdr = await cmd.ExecuteReaderAsync();
            while (await rdr.ReadAsync())
                list.Add(new ExecutionLogEntry
                {
                    ExecutionId     = rdr.IsDBNull(0) ? null : rdr.GetGuid(0),
                    ExecutionDate   = rdr.GetDateTime(1),
                    ReportName      = rdr.IsDBNull(2) ? "" : rdr.GetString(2),
                    Status          = rdr.IsDBNull(3) ? "" : rdr.GetString(3),
                    RowsRetrieved   = rdr.IsDBNull(4) ? 0 : rdr.GetInt32(4),
                    RowsInserted    = rdr.IsDBNull(5) ? 0 : rdr.GetInt32(5),
                    DurationTimeJob = rdr.IsDBNull(6) ? "" : rdr.GetString(6),
                    ErrorMessage    = rdr.IsDBNull(7) ? null : rdr.GetString(7),
                    TableSizeMB     = rdr.IsDBNull(8) ? null : (float?)Convert.ToSingle(rdr.GetValue(8)),
                });
            _all = list;
            _hasData = _all.Count > 0;
        }
        catch { _hasData = false; }
        finally { _loading = false; }
    }

    private static async Task<bool> ColumnExistsAsync(SqlConnection conn, string table, string column)
    {
        await using var cmd = new SqlCommand(
            "SELECT COUNT(*) FROM INFORMATION_SCHEMA.COLUMNS WHERE TABLE_NAME=@t AND COLUMN_NAME=@c", conn);
        cmd.Parameters.AddWithValue("@t", table);
        cmd.Parameters.AddWithValue("@c", column);
        return (int)(await cmd.ExecuteScalarAsync())! > 0;
    }

    private IEnumerable<ExecutionLogEntry> Filtered()
    {
        var q = _all.AsEnumerable();
        if (!string.IsNullOrWhiteSpace(_search))
        {
            var s = _search.Trim().ToLowerInvariant();
            q = q.Where(r => r.ReportName.ToLower().Contains(s)
                           || r.Status.ToLower().Contains(s)
                           || (r.ErrorMessage?.ToLower().Contains(s) ?? false)
                           || (r.ExecutionId.HasValue && r.ExecutionId.Value.ToString("D").ToLower().Contains(s)));
        }
        q = _sortCol switch
        {
            "ExecutionId"     => _sortDesc ? q.OrderByDescending(r => r.ExecutionId)      : q.OrderBy(r => r.ExecutionId),
            "ReportName"      => _sortDesc ? q.OrderByDescending(r => r.ReportName)       : q.OrderBy(r => r.ReportName),
            "Status"          => _sortDesc ? q.OrderByDescending(r => r.Status)            : q.OrderBy(r => r.Status),
            "RowsRetrieved"   => _sortDesc ? q.OrderByDescending(r => r.RowsRetrieved)    : q.OrderBy(r => r.RowsRetrieved),
            "RowsInserted"    => _sortDesc ? q.OrderByDescending(r => r.RowsInserted)     : q.OrderBy(r => r.RowsInserted),
            "DurationTimeJob" => _sortDesc ? q.OrderByDescending(r => r.DurationTimeJob)  : q.OrderBy(r => r.DurationTimeJob),
            "TableSizeMB"     => _sortDesc ? q.OrderByDescending(r => r.TableSizeMB)      : q.OrderBy(r => r.TableSizeMB),
            _                 => _sortDesc ? q.OrderByDescending(r => r.ExecutionDate)    : q.OrderBy(r => r.ExecutionDate),
        };
        return q;
    }

    private void SortBy(string col)
    {
        if (_sortCol == col) _sortDesc = !_sortDesc;
        else { _sortCol = col; _sortDesc = true; }
        _page = 1;
    }

    private string SortClass(string col) =>
        _sortCol == col ? (_sortDesc ? "sort-desc" : "sort-asc") : "";

    private async Task CopyToClipboard(string text)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
            _copiedId = Guid.Parse(text);
            StateHasChanged();
            await Task.Delay(2000);
            _copiedId = null;
            StateHasChanged();
        }
        catch { }
    }

    private void OnStateChanged() => _ = InvokeAsync(async () =>
    {
        await LoadLogsAsync();
        StateHasChanged();
    });

    public void Dispose() => State.OnChanged -= OnStateChanged;
}
