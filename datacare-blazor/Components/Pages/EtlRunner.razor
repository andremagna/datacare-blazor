@page "/"
@using DataCare.Models
@using DataCare.Services
@using Microsoft.Data.SqlClient
@inject EtlService EtlSvc
@inject EtlStateService State
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>ETL Runner — DataCare</PageTitle>

<!-- ── Reset confirmation modal ─────────────────────────────────────── -->
@if (_showResetConfirm)
{
    <div class="modal-overlay">
        <div class="modal-box">
            <div class="modal-icon">&#9888;</div>
            <div class="modal-title">Terminate execution?</div>
            <div class="modal-body">
                An ETL run is currently in progress.<br />
                Are you sure you want to stop it and reset the view?
            </div>
            <div class="modal-footer">
                <button class="btn-modal-cancel" @onclick="() => _showResetConfirm = false">Cancel</button>
                <button class="btn-modal-confirm" @onclick="ConfirmReset">Yes, terminate</button>
            </div>
        </div>
    </div>
}

<!-- ── Variable picker modal ─────────────────────────────────────────── -->
@if (_showVarPicker)
{
    <div class="modal-overlay" @onclick="CloseVarPicker">
        <div class="modal-box var-modal" @onclick:stopPropagation="true">
            <div class="modal-header-row">
                <span class="modal-title">Select Environment</span>
                <button class="modal-close-x" @onclick="CloseVarPicker">✕</button>
            </div>
            <p class="var-modal-hint">Click a row to populate the form fields automatically.</p>
            <div class="var-list">
                @{
                    var _envSnap = _envConfigs.ToList();
                }
                @foreach (var env in _envSnap)
                {
                    <button class="var-item" @onclick="@(() => ApplyEnv(env))">
                        <span class="var-item-key">@env.EnvironmentKey</span>
                        <span class="var-item-detail">@Mask(env.TenantId)</span>
                    </button>
                }
            </div>
        </div>
    </div>
}

<div class="etl-page">
    
    <!-- ── Page header: title + Variable button ─────────────────────── -->
    <div class="section-header-row">
        
        <div>
            <h1 class="dash-title" tabindex="-1" style="outline:none!important;border:none!important;box-shadow:none!important;">ETL Runner</h1>
            <span class="dash-sub">Configure and launch data extraction</span>
        </div>
        @if (_envConfigs.Count > 0)
        {
            <button class="btn-variable" @onclick="OpenVarPicker" title="Fill fields from saved environment">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <ellipse cx="12" cy="5" rx="9" ry="3" />
                    <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3" />
                    <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5" />
                </svg>
                Variable
            </button>
        }
    </div>

    <div class="config-panel">
        <div class="sdiv section-inline">ENTRA ID</div>
        <div class="g3">      
            <div>
                <div class="fl">Tenant ID</div>
                <input class="fi @(_submitted && string.IsNullOrWhiteSpace(_cfg.TenantId) ? "fi-error" : "")"
                       @bind="_cfg.TenantId"
                       placeholder="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx" />
                @if (_submitted && string.IsNullOrWhiteSpace(_cfg.TenantId))
                {
                    <div class="field-err">required field</div>
                }
            </div>
            <div>
                <div class="fl">Client ID</div>
                <input class="fi @(_submitted && string.IsNullOrWhiteSpace(_cfg.ClientId) ? "fi-error" : "")"
                       @bind="_cfg.ClientId"
                       placeholder="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx" />
                @if (_submitted && string.IsNullOrWhiteSpace(_cfg.ClientId))
                {
                    <div class="field-err">required field</div>
                }
            </div>
            <div>
                <div class="fl">Certificate Thumbprint</div>
                <input class="fi @(_submitted && string.IsNullOrWhiteSpace(_cfg.CertificateThumbprint) ? "fi-error" : "")"
                       @bind="_cfg.CertificateThumbprint"
                       placeholder="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx" />
                @if (_submitted && string.IsNullOrWhiteSpace(_cfg.CertificateThumbprint))
                {
                    <div class="field-err">required field</div>
                }
            </div>
        </div>

        @* <div class="config-divider"></div> *@

        <div class="sdiv config-section-label">SQL Server</div>
        <div class="g2">
            <div>
                <div class="fl">Server</div>
                <input class="fi" @bind="_cfg.SqlServer" @bind:after="OnSqlFieldChanged" placeholder="localhost\SQLEXPRESS" />
            </div>
            <div>
                <div class="fl">Database</div>
                <input class="fi" @bind="_cfg.SqlDatabase" @bind:after="OnSqlFieldChanged" placeholder="DataCareTest" />
            </div>
        </div>

        @* <div class="config-divider"></div> *@

        <div class="sdiv config-section-label">Report days</div>
        <div class="g1">
            <div>
                <div class="fl">Report period</div>
                <select class="fs" @bind="_cfg.Period">
                    <option value="D7">D7 — Last 7 days</option>
                    <option value="D30">D30 — Last 30 days</option>
                    <option value="D90">D90 — Last 90 days</option>
                    <option value="D180">D180 — Last 180 days</option>
                </select>
            </div>
        </div>
    </div>

    <div class="sdiv">Execution log</div>
    <div class="term" id="terminal">
        @{
            var _lines = State.TerminalLines.ToList();
        }
        @if (!_lines.Any())
        {
            <div class="t-d">DataCare ready &mdash; fill in the parameters and press Run ETL.</div>
        }
        @foreach (var line in _lines)
        {
            <div class="@line.CssClass">
                <span class="t-ts">@line.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</span>
                &nbsp;&mdash;&nbsp;@line.Message
            </div>
        }
    </div>

    <div class="prog-row">
        <span>@State.ProgressLabel</span>
        <span>@(State.Progress)%</span>
    </div>
    <div class="prog-track">
        <div class="prog-fill" style="width:@(State.Progress)%"></div>
    </div>

    <div class="footer-row">
        <span class="@State.StatusCss">@State.StatusText</span>
        @if (State.IsRunning)
        {
            <button class="btn-cancel" @onclick="CancelRun">Cancel</button>
        }
        <button class="btn-reset" @onclick="RequestReset" title="Reset view">&#8635; Reset</button>
        <button class="btn-run" @onclick="StartRun" disabled="@(State.IsRunning)">
            Run ETL
        </button>
    </div>

    @if (State.HistoryRows.Any())
    {
        <div class="etl-hist">
            <div class="hist-title">Execution history</div>
            <table class="htable">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Report</th>
                        <th>Status</th>
                        <th>Retrieved</th>
                        <th>Inserted</th>
                        <th>Duration</th>
                        <th>Error</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in State.HistoryRows)
                    {
                        <tr>
                            <td>@row.ExecutionDate.ToString("dd MMM yyyy HH:mm:ss")</td>
                            <td>@row.ReportName</td>
                            <td>
                                <span class="hbadge @(row.IsSuccess ? "ok" : "fail")">
                                    @row.Status
                                </span>
                            </td>
                            <td>@row.RowsRetrieved.ToString("N0")</td>
                            <td>@row.RowsInserted.ToString("N0")</td>
                            <td>@(string.IsNullOrWhiteSpace(row.DurationTimeJob) ? "—" : row.DurationTimeJob)</td>
                            <td class="@(row.IsSuccess ? "err-ok" : "err-fail")">
                                @(row.ErrorMessage ?? "—")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private RunConfig _cfg = new();
    private bool _submitted = false;
    private CancellationTokenSource? _cts;
    private bool _showResetConfirm = false;

    // Variable picker state
    private bool _showVarPicker = false;
    private List<EnvironmentConfig> _envConfigs = new();

    private bool IsValid =>
        !string.IsNullOrWhiteSpace(_cfg.TenantId) &&
        !string.IsNullOrWhiteSpace(_cfg.ClientId) &&
        !string.IsNullOrWhiteSpace(_cfg.CertificateThumbprint);

    protected override async Task OnInitializedAsync()
    {
        State.OnChanged += OnStateChanged;
        // Push whatever default CS is already in _cfg so pages can connect immediately
        State.SetConnectionString(_cfg.TargetConnectionString);
        await LoadEnvConfigsAsync();
    }

    /// <summary>Called whenever SqlServer or SqlDatabase fields change — updates state CS and reloads env configs.</summary>
    private async Task OnSqlFieldChanged()
    {
        if (!string.IsNullOrWhiteSpace(_cfg.SqlServer) && !string.IsNullOrWhiteSpace(_cfg.SqlDatabase))
        {
            State.SetConnectionString(_cfg.TargetConnectionString);
            await LoadEnvConfigsAsync();
            StateHasChanged();
        }
    }

    private async Task LoadEnvConfigsAsync()
    {
        var cs = (!string.IsNullOrWhiteSpace(_cfg.SqlServer) && !string.IsNullOrWhiteSpace(_cfg.SqlDatabase))
            ? _cfg.TargetConnectionString
            : State.LastConnectionString;

        if (string.IsNullOrWhiteSpace(cs)) return;
        try
        {
            // Prima verifica che il DB esista interrogando master — evita il
            // "Cannot open database / Login failed" quando il DB non è ancora stato creato.
            if (!string.IsNullOrWhiteSpace(_cfg.SqlServer) && !string.IsNullOrWhiteSpace(_cfg.SqlDatabase))
            {
                await using var master = new SqlConnection(_cfg.MasterConnectionString);
                await master.OpenAsync();
                await using var chk = new SqlCommand(
                    "SELECT COUNT(*) FROM sys.databases WHERE name=@n", master);
                chk.Parameters.AddWithValue("@n", _cfg.SqlDatabase);
                if ((int)(await chk.ExecuteScalarAsync())! == 0) return;
            }

            await using var conn0 = new SqlConnection(cs);
            await conn0.OpenAsync();
            await using var ensureCmd = new SqlCommand(TableDdl.EnvConfigDdl, conn0);
            await ensureCmd.ExecuteNonQueryAsync();

            var list = new List<EnvironmentConfig>();
            await using var conn = new SqlConnection(cs);
            await conn.OpenAsync();
            await using var cmd = new SqlCommand(TableDdl.EnvConfigSelectAll, conn);
            await using var rdr = await cmd.ExecuteReaderAsync();
            while (await rdr.ReadAsync())
                list.Add(new EnvironmentConfig
                {
                    Id = rdr.GetInt32(0),
                    EnvironmentKey = rdr.GetString(1),
                    TenantId = rdr.GetString(2),
                    ClientId = rdr.GetString(3),
                    CertificateThumbprint = rdr.GetString(4),
                    CreatedAt = rdr.GetDateTime(5),
                });
            _envConfigs = list;
        }
        catch { }
    }

    private void OpenVarPicker() => _showVarPicker = true;
    private void CloseVarPicker() => _showVarPicker = false;

    private void ApplyEnv(EnvironmentConfig env)
    {
        _cfg.TenantId = env.TenantId;
        _cfg.ClientId = env.ClientId;
        _cfg.CertificateThumbprint = env.CertificateThumbprint;
        _showVarPicker = false;
        StateHasChanged();
    }

    private static string Mask(string s) => s.Length > 8 ? s[..8] + "…" : s;

    private void StartRun()
    {
        _submitted = true;
        if (!IsValid) { StateHasChanged(); return; }
        if (State.IsRunning) return;

        var snapshot = new RunConfig
        {
            TenantId = _cfg.TenantId.Trim(),
            ClientId = _cfg.ClientId.Trim(),
            CertificateThumbprint = _cfg.CertificateThumbprint.Trim(),
            SqlServer = _cfg.SqlServer.Trim(),
            SqlDatabase = _cfg.SqlDatabase.Trim(),
            Period = _cfg.Period,
        };

        State.StartRun(snapshot.TargetConnectionString);
        StateHasChanged();

        _cts = new CancellationTokenSource();
        _ = Task.Run(() => EtlSvc.RunAsync(snapshot, _cts.Token));
    }

    private void CancelRun() => _cts?.Cancel();

    private void RequestReset()
    {
        if (State.IsRunning)
            _showResetConfirm = true;
        else
            DoReset();
    }

    private void ConfirmReset()
    {
        _cts?.Cancel();
        _showResetConfirm = false;
        DoReset();
    }

    private void DoReset()
    {
        _submitted = false;
        State.Reset();
        StateHasChanged();
    }

    private void OnStateChanged()
    {
        _ = InvokeAsync(async () =>
        {
            try
            {
                await LoadEnvConfigsAsync();
                StateHasChanged();
                await JS.InvokeVoidAsync("datacareTerminal.scrollToBottom", "terminal");
            }
            catch { }
        });
    }

    public void Dispose()
    {
        State.OnChanged -= OnStateChanged;
        _cts?.Dispose();
    }
}

<style>
    /* ── Config panel (wraps all parameter sections) ────────────────────── */
    .config-panel {
        background: #080e1c;
        border: 1px solid #1e3050;
        border-radius: 12px;
        padding: 1.4rem 1.6rem;
        margin-bottom: 1.2rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }
    .config-divider {
        border: none;
        border-top: 1px solid #1a2540;
        margin: .25rem 0;
    }
    .config-section-label {
        margin-top: 0 !important;
        margin-bottom: 8px !important;
    }

    /* ── Section header with optional button ─────────────────────────── */
    .section-header-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1.2rem;
    }
    .section-inline { margin-bottom: 0 !important; }

    /* ── Variable button ─────────────────────────────────────────────── */
    .btn-variable {
        display: flex; align-items: center; gap: .4rem;
        background: #0d1a30; border: 1px solid #2a5080; color: #5ab5ff;
        border-radius: 6px; padding: .35rem .85rem; font-size: .78rem; font-weight: 600;
        cursor: pointer; transition: background .15s, border-color .15s, color .15s;
        white-space: nowrap;
    }
    .btn-variable:hover { background: #112040; border-color: #1B8FFF; color: #90d0ff; }

    /* ── Variable picker modal ───────────────────────────────────────── */
    .var-modal { max-width: 420px; gap: .9rem; }
    .modal-header-row { display: flex; align-items: center; justify-content: space-between; }
    .modal-close-x { background: none; border: none; color: #446; font-size: 1.1rem; cursor: pointer; padding: .2rem .4rem; }
    .modal-close-x:hover { color: #90aac0; }
    .var-modal-hint { font-size: .78rem; color: #4a6a88; margin: 0; }
    .var-list { display: flex; flex-direction: column; gap: .4rem; max-height: 300px; overflow-y: auto; }
    .var-item {
        display: flex; align-items: center; justify-content: space-between;
        background: #10101f; border: 1px solid #1e2a44; border-radius: 7px;
        padding: .65rem 1rem; cursor: pointer; text-align: left;
        transition: background .15s, border-color .15s;
    }
    .var-item:hover { background: #141428; border-color: #1B8FFF; }
    .var-item-key { font-weight: 700; color: #5ab5ff; font-size: .86rem; }
    .var-item-detail { font-family: monospace; font-size: .74rem; color: #5a7a9a; }

    /* ── Reset button ─────────────────────────────────────────────── */
    .btn-reset { background:transparent; border:1px solid #2a3a55; color:#5a7a9a;
                 border-radius:6px; padding:.42rem .9rem; font-size:.8rem;
                 cursor:pointer; transition: border-color .15s, color .15s; }
    .btn-reset:hover { border-color:#7aaccc; color:#a0cce0; }

    /* ── Modal overlay ────────────────────────────────────────────── */
    .modal-overlay  { position:fixed; inset:0; background:rgba(0,0,0,.65);
                      display:flex; align-items:center; justify-content:center;
                      z-index:10000; }
    .modal-box      { background:#0d1220; border:1px solid #1e3050; border-radius:12px;
                      padding:2rem 2.2rem; max-width:420px; width:90%;
                      box-shadow:0 8px 40px rgba(0,0,0,.7);
                      display:flex; flex-direction:column; gap:1rem; }
    .modal-icon     { font-size:2.2rem; color:#f59e0b; text-align:center; }
    .modal-title    { font-size:1.05rem; font-weight:700; color:#c8daf0; text-align:center; }
    .modal-body     { font-size:.88rem; color:#7090aa; text-align:center; line-height:1.55; }
    .modal-footer   { display:flex; gap:.7rem; justify-content:center; margin-top:.4rem; }
    .btn-modal-cancel  { background:transparent; border:1px solid #2a3a55; color:#6a8aaa;
                         border-radius:7px; padding:.5rem 1.4rem; font-size:.85rem;
                         cursor:pointer; transition: border-color .15s, color .15s; }
    .btn-modal-cancel:hover { border-color:#5a7a9a; color:#a0bcd0; }
    .btn-modal-confirm { background:#b91c1c; border:1px solid #ef4444; color:#fff;
                         border-radius:7px; padding:.5rem 1.4rem; font-size:.85rem;
                         font-weight:600; cursor:pointer;
                         transition: background .15s; }
    .btn-modal-confirm:hover { background:#dc2626; }
</style>
