@page "/dashboard"
@using DataCare.Models
@using DataCare.Services
@using Microsoft.Data.SqlClient
@using System.Text
@inject EtlStateService State
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>DataCare Dashboard</PageTitle>

@* FIX 7: always show dashboard — no more "run ETL first" gate *@
@if (_loading)
{
    <div class="dash-empty">
        <p class="dash-empty-msg">Loading dashboard data...</p>
    </div>
}
else if (!_hasData)
{
    <div class="dash-empty">
        <div class="dash-empty-icon">
            <svg viewBox="0 0 64 64" fill="none" width="64" height="64">
                <rect x="4" y="4" width="26" height="26" rx="4" fill="#1a3a6b" opacity=".5" />
                <rect x="34" y="4" width="26" height="26" rx="4" fill="#1a3a6b" opacity=".3" />
                <rect x="4" y="34" width="26" height="26" rx="4" fill="#1a3a6b" opacity=".3" />
                <rect x="34" y="34" width="26" height="26" rx="4" fill="#1a3a6b" opacity=".15" />
            </svg>
        </div>
        <h2 class="dash-empty-title">No data available yet</h2>
        <p class="dash-empty-msg">Run the ETL from the <a href="/">Home</a> page to populate the dashboard.</p>
    </div>
}
else
{
    <div class="dashboard-page">

        <!-- ── Header ────────────────────────────────────────────────── -->
        <div class="dash-header">
            <div>
                <h1 class="dash-title">DataCare Dashboard</h1>
                <span class="dash-sub">Monitor and analyze your data</span>
            </div>

            @if (!string.IsNullOrEmpty(_downloadError))
            {
                <div class="sched-feedback fb-err" style="width:100%;margin-bottom:.5rem;">@_downloadError</div>
            }

            <!-- FIX 3: filters below download buttons -->
            <div class="filters-row">
                <div class="filter-item">
                    <label class="filter-label">Department</label>
                    <select class="filter-select" @bind="_selectedDept" @bind:after="OnFiltersChanged">
                        <option value="">All departments</option>
                        @foreach (var d in _departments)
                        {
                            <option value="@d">@d</option>
                        }
                    </select>
                </div>
                <!-- FIX 5: Month filter -->
                <div class="filter-item">
                    <label class="filter-label">Month</label>
                    <select class="filter-select" @bind="_selectedYearMonth" @bind:after="OnFiltersChanged">
                        <option value="0">All months</option>
                        @foreach (var m in _months)
                        {
                            <option value="@m.YearMonth">@m.Label</option>
                        }
                    </select>
                </div>
            </div>

            <!-- FIX 3+4: Download buttons top-right, filters below them -->
            <div class="dash-controls">
                <!-- FIX 4: working download buttons -->
                <div class="dl-group">
                    <button class="dl-btn" @onclick="DownloadPdf">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                            <polyline points="14 2 14 8 20 8" />
                            <line x1="12" y1="18" x2="12" y2="12" />
                            <line x1="9" y1="15" x2="15" y2="15" />
                        </svg>PDF
                    </button>
                    <button class="dl-btn" @onclick="DownloadJson">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="16 18 22 12 16 6" />
                            <polyline points="8 6 2 12 8 18" />
                        </svg>JSON
                    </button>
                    <button class="dl-btn" @onclick="DownloadCsv">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                            <polyline points="7 10 12 15 17 10" />
                            <line x1="12" y1="15" x2="12" y2="3" />
                        </svg>CSV
                    </button>
                </div>

                
            </div>
        </div>

        <!-- USERS -->
        <div class="section-band"><span class="section-band-title">Users</span></div>
        <div class="cards-row mb-sm">
            <div class="dcard">
                <div class="dcard-title">Number of users</div>
                @BarChart("users", _data.Select(r => (r.MonthLabel, r.YearNum, (double)r.Users_Total)).ToList(), "#262626")
            </div>
            <!-- mappa SVG paesi -->
            <div class="dcard dcard-map">
                <div class="dcard-title">Country Involved</div>
                <div id="country-map" class="azure-map-container"></div>
            </div>
        </div>

        <!-- EXCHANGE -->
        <div class="section-band section-band-dark">
            @* <span class="section-badge-ex">E</span> *@
            <span class="section-band-title">Exchange</span>
        </div>
        <div class="cards-row no-mb">
            <div class="dcard">
                <div class="dcard-title">Items Count</div>
                @BarChart("ex-cnt", _data.Select(r => (r.MonthLabel, r.YearNum, (double)r.Exchange_Item_Count)).ToList(), "#1B8FFF")
            </div>
            <div class="dcard">
                <div class="dcard-title">Items Storage (GB)</div>
                @BarChart("ex-gb", _data.Select(r => (r.MonthLabel, r.YearNum, r.Exchange_StorageUsedGB)).ToList(), "#1B8FFF")
            </div>
            <div class="dcard">
                <div class="dcard-title">Deleted Item Count</div>
                @BarChart("ex-cnt", _data.Select(r => (r.MonthLabel, r.YearNum, (double)r.Exchange_Deleted_Item_Count)).ToList(), "#1B8FFF")
            </div>
            <div class="dcard">
                <div class="dcard-title">Deleted Item Storage (GB)</div>
                @BarChart("ex-gb", _data.Select(r => (r.MonthLabel, r.YearNum, r.Exchange_DeletedItemSizeGB)).ToList(), "#1B8FFF")
            </div>
            @* <div class="dcard">
                <div class="dcard-title">Deleted Items</div>
                @GroupedBarChart("ex-del",
                    _data.Select(r => (r.MonthLabel, r.YearNum)).ToList(),
                    new List<(string, Func<DashRow, double>, string)> {
                        ("Count",   r => (double)r.Exchange_Deleted_Item_Count, "#1B8FFF"),
                        ("Size GB", r => r.Exchange_DeletedItemSizeGB,           "#00C9B1"),
                    }, _data)
            </div> *@
        </div>

        <!-- ONEDRIVE + SHAREPOINT -->
        <div class="two-sections-row mb-sm">
            <div class="section-col">
                <div class="section-band section-band-dark">
                    @* <span class="section-badge-ex">O</span> *@
                    <span class="section-band-title">OneDrive</span>
                </div>
                <div class="cards-row no-mb">
                    <div class="dcard">
                        <div class="dcard-title">File Count</div>
                        @BarChart("od-fc", _data.Select(r => (r.MonthLabel, r.YearNum, (double)r.OneDrive_Total_File_Count)).ToList(), "#0b5394")
                    </div>
                    <div class="dcard">
                        <div class="dcard-title">File Storage (GB)</div>
                        @BarChart("od-gb", _data.Select(r => (r.MonthLabel, r.YearNum, r.OneDrive_Total_StorageUsedGB)).ToList(), "#0b5394")
                    </div>
                </div>
            </div>
            <div class="section-col">
                <div class="section-band section-band-teal">
                    @* <span class="section-badge-sp">S</span> *@
                    <span class="section-band-title">SharePoint</span>
                </div>
                <div class="cards-row no-mb">
                    <div class="dcard">
                        <div class="dcard-title">File Count</div>
                        @BarChart("sp-fc", _data.Select(r => (r.MonthLabel, r.YearNum, (double)r.SharePoint_Total_File_Count)).ToList(), "#00C9B1")
                    </div>
                    <div class="dcard">
                        <div class="dcard-title">File Storage (GB)</div>
                        @BarChart("sp-gb", _data.Select(r => (r.MonthLabel, r.YearNum, r.SharePoint_Total_StorageUsedGB)).ToList(), "#00C9B1")
                    </div>
                </div>
            </div>
        </div>

        
    </div>
}

<div id="chart-tooltip" class="chart-tooltip" style="display:none;"></div>

@code {
    private bool _loading = true;
    private bool _hasData = false;
    private List<DashRow> _data = new();
    private List<CountryRow> _countries = new();
    private List<string> _departments = new();
    private List<MonthItem> _months = new();
    private string _selectedDept = "";
    private int _selectedYearMonth = 0;
    private bool _mapRendered = false;
    private string? _cs;
    private string _downloadError = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        State.OnChanged += OnStateChanged;
        // FIX 7: try loading from existing DB immediately regardless of ETL state
        _cs = State.LastConnectionString;
        await LoadDataAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_loading && _hasData && _countries.Count > 0)
            await RenderMapAsync();
    }

    private async Task RenderMapAsync()
    {
        if (_mapRendered) return;
        try
        {
            // Small delay to ensure the DOM element exists and Leaflet is ready
            await Task.Delay(150);
            var pts = _countries
                .Where(c => !string.IsNullOrWhiteSpace(c.CountryName) && c.CountryName != "Unknown")
                .Select(c => new { name = c.CountryName, count = c.CountryCount })
                .ToArray();
            await JS.InvokeVoidAsync("datacareMap.init", "country-map", pts);
            _mapRendered = true;
        }
        catch { }
    }

    private async Task LoadDataAsync()
    {
        _loading = true;

        // Refresh connection string if ETL just ran
        if (!string.IsNullOrWhiteSpace(State.LastConnectionString))
            _cs = State.LastConnectionString;

        if (string.IsNullOrWhiteSpace(_cs)) { _loading = false; return; }

        try
        {
            // Check history table exists and has rows
            bool histExists = await TableExistsAsync(_cs, "PowerBIDataModelHistory");
            if (!histExists) { _hasData = false; _loading = false; return; }

            int histCount = await ScalarIntAsync(_cs, "SELECT COUNT(*) FROM dbo.PowerBIDataModelHistory");
            if (histCount == 0) { _hasData = false; _loading = false; return; }

            // Load filter lists (only once)
            if (_departments.Count == 0)
                _departments = await QueryListAsync(_cs, TableDdl.DepartmentListQuery(), r => r.GetString(0));
            if (_months.Count == 0)
                _months = await QueryListAsync(_cs, TableDdl.MonthListQuery(),
                    r => new MonthItem { YearMonth = r.GetInt32(0), Label = r.GetString(1) });

            // FIX 6: pass yearMonth filter
            int? ym = _selectedYearMonth > 0 ? _selectedYearMonth : (int?)null;
            _data = await QueryListAsync(_cs, TableDdl.DashboardQuery(_selectedDept, ym), r => new DashRow
            {
                MonthLabel = r.IsDBNull(0) ? "" : r.GetString(0),
                YearNum = r.IsDBNull(1) ? 0 : r.GetInt32(1),
                MonthNum = r.IsDBNull(2) ? 0 : r.GetInt32(2),
                Exchange_Item_Count = r.IsDBNull(3) ? 0L : r.GetInt64(3),
                Exchange_Deleted_Item_Count = r.IsDBNull(4) ? 0L : r.GetInt64(4),
                Exchange_StorageUsedGB = r.IsDBNull(5) ? 0 : (double)r.GetDecimal(5),
                Exchange_DeletedItemSizeGB = r.IsDBNull(6) ? 0 : (double)r.GetDecimal(6),
                OneDrive_Total_File_Count = r.IsDBNull(7) ? 0L : r.GetInt64(7),
                OneDrive_Total_StorageUsedGB = r.IsDBNull(8) ? 0 : (double)r.GetDecimal(8),
                SharePoint_Total_File_Count = r.IsDBNull(9) ? 0L : r.GetInt64(9),
                SharePoint_Total_StorageUsedGB = r.IsDBNull(10) ? 0 : (double)r.GetDecimal(10),
                Users_Total = r.IsDBNull(11) ? 0L : r.GetInt64(11),
            });

            _countries = await QueryListAsync(_cs, TableDdl.CountryQuery(_selectedDept), r => new CountryRow
            {
                CountryName = r.IsDBNull(0) ? "Unknown" : r.GetString(0),
                CountryCount = r.IsDBNull(1) ? 0 : r.GetInt32(1),
            });

            _hasData = _data.Count > 0 || _countries.Count > 0;
        }
        catch { _hasData = false; }
        finally { _loading = false; }
    }

    private async Task OnFiltersChanged()
    {
        _mapRendered = false;
        await LoadDataAsync();
        StateHasChanged();
    }

    private void OnStateChanged() => _ = InvokeAsync(async () =>
    {
        await LoadDataAsync();
        StateHasChanged();
    });

    public void Dispose() => State.OnChanged -= OnStateChanged;

    // ── DB helpers ────────────────────────────────────────────────────────
    private static async Task<bool> TableExistsAsync(string cs, string table)
    {
        try
        {
            await using var conn = new SqlConnection(cs);
            await conn.OpenAsync();
            await using var cmd = new SqlCommand(
                $"SELECT COUNT(*) FROM INFORMATION_SCHEMA.TABLES WHERE TABLE_NAME='{table}'", conn);
            return (int)(await cmd.ExecuteScalarAsync())! > 0;
        }
        catch { return false; }
    }

    private static async Task<int> ScalarIntAsync(string cs, string sql)
    {
        await using var conn = new SqlConnection(cs);
        await conn.OpenAsync();
        await using var cmd = new SqlCommand(sql, conn);
        return (int)(await cmd.ExecuteScalarAsync())!;
    }

    private static async Task<List<T>> QueryListAsync<T>(string cs, string sql, Func<SqlDataReader, T> map)
    {
        var list = new List<T>();
        await using var conn = new SqlConnection(cs);
        await conn.OpenAsync();
        await using var cmd = new SqlCommand(sql, conn);
        await using var rdr = await cmd.ExecuteReaderAsync();
        while (await rdr.ReadAsync()) list.Add(map(rdr));
        return list;
    }

    // ── FIX 4: Download ───────────────────────────────────────────────────
    private async Task DownloadJson()
    {
        _downloadError = string.Empty;
        try
        {
            var dept = string.IsNullOrWhiteSpace(_selectedDept) ? "all" : _selectedDept;
            var obj = new { department = dept, generatedAt = DateTime.UtcNow, metrics = _data, countries = _countries };
            var json = System.Text.Json.JsonSerializer.Serialize(obj,
                new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
            var bytes = Encoding.UTF8.GetBytes(json);
            var fileName = $"datacare_{dept}_{DateTime.Now:yyyyMMdd}.json";
            await JS.InvokeVoidAsync("datacareExport.downloadBase64", fileName, "application/json",
                Convert.ToBase64String(bytes));
            await SaveDownloadRecordAsync(bytes, "application/json", fileName);
        }
        catch (Exception ex) { _downloadError = $"Errore salvataggio download: {ex.Message}"; }
    }

    private async Task DownloadCsv()
    {
        _downloadError = string.Empty;
        try
        {
            var dept = string.IsNullOrWhiteSpace(_selectedDept) ? "all" : _selectedDept;
            var sb = new StringBuilder();
            sb.AppendLine("MonthLabel,Year,Month,Exchange_Item_Count,Exchange_Deleted_Item_Count," +
                          "Exchange_StorageUsedGB,Exchange_DeletedItemSizeGB," +
                          "OneDrive_File_Count,OneDrive_StorageUsedGB," +
                          "SharePoint_File_Count,SharePoint_StorageUsedGB,Users_Total");
            foreach (var r in _data)
                sb.AppendLine($"\"{r.MonthLabel}\",{r.YearNum},{r.MonthNum}," +
                              $"{r.Exchange_Item_Count},{r.Exchange_Deleted_Item_Count}," +
                              $"{r.Exchange_StorageUsedGB:F2},{r.Exchange_DeletedItemSizeGB:F2}," +
                              $"{r.OneDrive_Total_File_Count},{r.OneDrive_Total_StorageUsedGB:F2}," +
                              $"{r.SharePoint_Total_File_Count},{r.SharePoint_Total_StorageUsedGB:F2},{r.Users_Total}");
            var bytes = Encoding.UTF8.GetBytes(sb.ToString());
            var fileName = $"datacare_{dept}_{DateTime.Now:yyyyMMdd}.csv";
            await JS.InvokeVoidAsync("datacareExport.downloadBase64", fileName, "text/csv",
                Convert.ToBase64String(bytes));
            await SaveDownloadRecordAsync(bytes, "text/csv", fileName);
        }
        catch (Exception ex) { _downloadError = $"Errore salvataggio download: {ex.Message}"; }
    }

    private async Task DownloadPdf()
    {
        _downloadError = string.Empty;
        try
        {
            await JS.InvokeVoidAsync("datacareExport.downloadPdf");
            var dept = string.IsNullOrWhiteSpace(_selectedDept) ? "all" : _selectedDept;
            var fileName = $"datacare_{dept}_{DateTime.Now:yyyyMMdd}.pdf";
            // PDF bytes not available client-side from jsPDF; store a placeholder record without binary
            await SaveDownloadRecordAsync(null, "application/pdf", fileName);
        }
        catch (Exception ex) { _downloadError = $"Errore salvataggio download: {ex.Message}"; }
    }

    /// <summary>Persists a download event in dbo.DownloadFile.</summary>
    private async Task SaveDownloadRecordAsync(byte[]? fileBytes, string mimeType, string fileName)
    {
        // Usa sia State.LastConnectionString che il campo locale _cs per massima robustezza
        var cs = State.LastConnectionString;
        if (string.IsNullOrWhiteSpace(cs)) cs = _cs;
        if (string.IsNullOrWhiteSpace(cs)) return;

        await using var conn = new SqlConnection(cs);
        await conn.OpenAsync();
        // Crea la tabella se non esiste ancora
        await using (var ddl = new SqlCommand(TableDdl.All["DownloadFile"], conn))
            await ddl.ExecuteNonQueryAsync();
        await using var cmd = new SqlCommand(TableDdl.DownloadFileInsert, conn);
        cmd.Parameters.Add("@File", System.Data.SqlDbType.VarBinary).Value =
            fileBytes != null ? (object)fileBytes : DBNull.Value;
        cmd.Parameters.AddWithValue("@FileType", mimeType);
        cmd.Parameters.AddWithValue("@FileName", fileName);
        cmd.Parameters.AddWithValue("@FileStorage", "dbo.DownloadFile / File (VARBINARY)");
        await cmd.ExecuteNonQueryAsync();
    }

    // ═══════════════════════════════════════════════════════════════════════
    //  CHART RENDERERS
    // ═══════════════════════════════════════════════════════════════════════
    private const int CW = 360, CH = 200;
    private const int PL = 48, PR = 12, PT = 26, PB = 46;
    private static int PlotW => CW - PL - PR;
    private static int PlotH => CH - PT - PB;

    private static RenderFragment BarChart(
        string id,
        List<(string Month, int Year, double Val)> data,
        string color) => b =>
    {
        if (data == null || data.Count == 0) { RenderEmpty(b); return; }

        double max = data.Max(d => d.Val);
        double topV = NiceTop(max);
        double step = NiceStep(max, 5);
        int n = data.Count;
        double slotW = (double)PlotW / n;
        double barW = Math.Max(8, Math.Min(52, slotW * 0.55));

        b.OpenElement(0, "svg");
        b.AddAttribute(1, "viewBox", $"0 0 {CW} {CH}");
        b.AddAttribute(2, "style", "width:100%;height:200px;display:block;overflow:visible;");
        b.AddAttribute(3, "xmlns", "http://www.w3.org/2000/svg");

        RenderGradDef(b, $"g{id}", color);
        RenderYAxis(b, step, topV);

        for (int i = 0; i < n; i++)
        {
            double v = data[i].Val;
            double bH = topV > 0 ? Math.Max(2, v / topV * PlotH) : 2;
            double bX = PL + slotW * i + (slotW - barW) / 2;
            double bY = PT + PlotH - bH;
            string lbl = $"{data[i].Month} {data[i].Year}: {FormatVal(v)}";

            b.OpenElement(0, "g");
            b.AddAttribute(0, "class", "bar-g");
            b.AddAttribute(0, "onmouseenter", $"datacareChart.show(event,'{lbl}')");
            b.AddAttribute(0, "onmousemove", "datacareChart.move(event)");
            b.AddAttribute(0, "onmouseleave", "datacareChart.hide()");

            // invisible hit area
            b.OpenElement(0, "rect");
            b.AddAttribute(0, "x", Fmt(bX - 6)); b.AddAttribute(0, "y", PT.ToString());
            b.AddAttribute(0, "width", Fmt(barW + 12)); b.AddAttribute(0, "height", PlotH.ToString());
            b.AddAttribute(0, "fill", "transparent");
            b.CloseElement();

            // bar
            b.OpenElement(0, "rect");
            b.AddAttribute(0, "class", "bar-r");
            b.AddAttribute(0, "x", Fmt(bX)); b.AddAttribute(0, "y", Fmt(bY));
            b.AddAttribute(0, "width", Fmt(barW)); b.AddAttribute(0, "height", Fmt(bH));
            b.AddAttribute(0, "rx", "3"); b.AddAttribute(0, "fill", $"url(#g{id})");
            b.CloseElement();

            // label above bar
            b.OpenElement(0, "text");
            b.AddAttribute(0, "x", Fmt(bX + barW / 2)); b.AddAttribute(0, "y", Fmt(bY - 5));
            b.AddAttribute(0, "text-anchor", "middle"); b.AddAttribute(0, "fill", "#c8daf0");
            b.AddAttribute(0, "font-size", "11"); b.AddAttribute(0, "font-weight", "600");
            b.AddAttribute(0, "font-family", "'Open Sans',sans-serif");
            b.AddContent(0, FormatVal(v));
            b.CloseElement();

            b.CloseElement(); // bar-g

            RenderXLabel(b, bX + barW / 2, data[i].Month, data[i].Year,
                i == 0 || data[i].Year != data[i - 1].Year);
        }

        RenderBaseline(b);
        b.CloseElement();
    };

    private static RenderFragment GroupedBarChart(
        string id,
        List<(string Month, int Year)> labels,
        List<(string Label, Func<DashRow, double> Get, string Color)> series,
        List<DashRow> rows) => b =>
    {
        if (rows == null || rows.Count == 0) { RenderEmpty(b); return; }

        int n = rows.Count;
        int s = series.Count;
        double max = rows.SelectMany(r => series.Select(sv => sv.Get(r))).DefaultIfEmpty(1).Max();
        double topV = NiceTop(max);
        double step = NiceStep(max, 5);
        double slotW = (double)PlotW / n;
        double gap = 3;
        double barW = Math.Max(5, Math.Min(30, (slotW * 0.7 - gap * (s - 1)) / s));
        double groupUsed = barW * s + gap * (s - 1);

        b.OpenElement(0, "svg");
        b.AddAttribute(1, "viewBox", $"0 0 {CW} {CH}");
        b.AddAttribute(2, "style", "width:100%;height:200px;display:block;overflow:visible;");
        b.AddAttribute(3, "xmlns", "http://www.w3.org/2000/svg");

        for (int si = 0; si < s; si++)
            RenderGradDef(b, $"gg{id}{si}", series[si].Color);

        // legend
        double legX = CW - PR - s * 72.0;
        for (int si = 0; si < s; si++)
        {
            b.OpenElement(0, "rect");
            b.AddAttribute(0, "x", Fmt(legX + si * 72)); b.AddAttribute(0, "y", "5");
            b.AddAttribute(0, "width", "10"); b.AddAttribute(0, "height", "10");
            b.AddAttribute(0, "rx", "2"); b.AddAttribute(0, "fill", series[si].Color);
            b.CloseElement();
            b.OpenElement(0, "text");
            b.AddAttribute(0, "x", Fmt(legX + si * 72 + 14)); b.AddAttribute(0, "y", "14");
            b.AddAttribute(0, "fill", "#8ab0d0"); b.AddAttribute(0, "font-size", "10");
            b.AddContent(0, series[si].Label);
            b.CloseElement();
        }

        RenderYAxis(b, step, topV);

        for (int i = 0; i < n; i++)
        {
            double gX = PL + slotW * i + (slotW - groupUsed) / 2;
            for (int si = 0; si < s; si++)
            {
                double v = series[si].Get(rows[i]);
                double bH = topV > 0 ? Math.Max(2, v / topV * PlotH) : 2;
                double bX = gX + si * (barW + gap);
                double bY = PT + PlotH - bH;
                string lbl = $"{labels[i].Month} {labels[i].Year} — {series[si].Label}: {FormatVal(v)}";

                b.OpenElement(0, "g");
                b.AddAttribute(0, "class", "bar-g");
                b.AddAttribute(0, "onmouseenter", $"datacareChart.show(event,'{lbl}')");
                b.AddAttribute(0, "onmousemove", "datacareChart.move(event)");
                b.AddAttribute(0, "onmouseleave", "datacareChart.hide()");

                b.OpenElement(0, "rect");
                b.AddAttribute(0, "class", "bar-r");
                b.AddAttribute(0, "x", Fmt(bX)); b.AddAttribute(0, "y", Fmt(bY));
                b.AddAttribute(0, "width", Fmt(barW)); b.AddAttribute(0, "height", Fmt(bH));
                b.AddAttribute(0, "rx", "2"); b.AddAttribute(0, "fill", $"url(#gg{id}{si})");
                b.CloseElement();
                b.CloseElement();
            }
            RenderXLabel(b, gX + groupUsed / 2, labels[i].Month, labels[i].Year,
                i == 0 || labels[i].Year != labels[i - 1].Year);
        }

        RenderBaseline(b);
        b.CloseElement();
    };

    // ── SVG helpers ──────────────────────────────────────────────────────
    private static void RenderGradDef(
        Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder b,
        string gid, string color)
    {
        b.OpenElement(0, "defs");
        b.OpenElement(0, "linearGradient");
        b.AddAttribute(0, "id", gid);
        b.AddAttribute(0, "x1", "0"); b.AddAttribute(0, "y1", "0");
        b.AddAttribute(0, "x2", "0"); b.AddAttribute(0, "y2", "1");
        b.OpenElement(0, "stop");
        b.AddAttribute(0, "offset", "0%"); b.AddAttribute(0, "stop-color", LightenHex(color, 50));
        b.AddAttribute(0, "stop-opacity", "1"); b.CloseElement();
        b.OpenElement(0, "stop");
        b.AddAttribute(0, "offset", "100%"); b.AddAttribute(0, "stop-color", color);
        b.AddAttribute(0, "stop-opacity", "1"); b.CloseElement();
        b.CloseElement(); b.CloseElement();
    }

    private static void RenderYAxis(
        Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder b,
        double step, double topV)
    {
        var ticks = new List<double>();
        for (double t = 0; t <= topV + step * 0.01; t += step) ticks.Add(t);
        foreach (var t in ticks)
        {
            double yp = PT + PlotH - (topV > 0 ? t / topV * PlotH : 0);
            b.OpenElement(0, "line");
            b.AddAttribute(0, "x1", PL.ToString()); b.AddAttribute(0, "y1", Fmt(yp));
            b.AddAttribute(0, "x2", (CW - PR).ToString()); b.AddAttribute(0, "y2", Fmt(yp));
            b.AddAttribute(0, "stroke", t == 0 ? "#2a3a55" : "#1c2538");
            b.AddAttribute(0, "stroke-width", t == 0 ? "1.2" : "0.7");
            b.AddAttribute(0, "stroke-dasharray", t == 0 ? "" : "4 3");
            b.CloseElement();
            b.OpenElement(0, "text");
            b.AddAttribute(0, "x", (PL - 6).ToString()); b.AddAttribute(0, "y", Fmt(yp + 4));
            b.AddAttribute(0, "text-anchor", "end"); b.AddAttribute(0, "fill", "#6a8aaa");
            b.AddAttribute(0, "font-size", "10"); b.AddAttribute(0, "font-family", "'Open Sans',monospace");
            b.AddContent(0, FormatVal(t));
            b.CloseElement();
        }
    }

    private static void RenderBaseline(
        Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder b)
    {
        b.OpenElement(0, "line");
        b.AddAttribute(0, "x1", PL.ToString()); b.AddAttribute(0, "y1", (PT + PlotH).ToString());
        b.AddAttribute(0, "x2", (CW - PR).ToString()); b.AddAttribute(0, "y2", (PT + PlotH).ToString());
        b.AddAttribute(0, "stroke", "#2a3a55"); b.AddAttribute(0, "stroke-width", "1.5");
        b.CloseElement();
    }

    private static void RenderXLabel(
        Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder b,
        double cx, string month, int year, bool showYear)
    {
        int bl = PT + PlotH;
        b.OpenElement(0, "text");
        b.AddAttribute(0, "x", Fmt(cx)); b.AddAttribute(0, "y", (bl + 16).ToString());
        b.AddAttribute(0, "text-anchor", "middle"); b.AddAttribute(0, "fill", "#8ab0cc");
        b.AddAttribute(0, "font-size", "11"); b.AddAttribute(0, "font-family", "'Open Sans',sans-serif");
        b.AddContent(0, month.Length > 3 ? month[..3] : month);
        b.CloseElement();
        if (showYear)
        {
            b.OpenElement(0, "text");
            b.AddAttribute(0, "x", Fmt(cx)); b.AddAttribute(0, "y", (bl + 30).ToString());
            b.AddAttribute(0, "text-anchor", "middle"); b.AddAttribute(0, "fill", "#4a6a88");
            b.AddAttribute(0, "font-size", "10"); b.AddAttribute(0, "font-weight", "600");
            b.AddContent(0, year.ToString());
            b.CloseElement();
        }
    }

    private static void RenderEmpty(
        Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder b)
    {
        b.OpenElement(0, "div"); b.AddAttribute(1, "class", "ch-empty");
        b.AddContent(2, "No data"); b.CloseElement();
    }

    // ── Maths & formatting ───────────────────────────────────────────────
    private static double NiceTop(double max)
    {
        if (max <= 0) return 1;
        double s = NiceStep(max, 5);
        return s * Math.Ceiling(max / s);
    }

    private static double NiceStep(double max, int ticks)
    {
        if (max <= 0) return 1;
        double raw = max / ticks;
        double mag = Math.Pow(10, Math.Floor(Math.Log10(raw)));
        foreach (var n in new[] { 1.0, 2, 2.5, 5, 10 })
            if (n * mag >= raw) return n * mag;
        return 10 * mag;
    }

    private static string FormatVal(double v)
    {
        if (v >= 1_000_000_000) return $"{v / 1_000_000_000:F2}Mld";
        if (v >= 1_000_000) return $"{v / 1_000_000:F2}Mln";
        if (v >= 1_000) return $"{v / 1_000:F1}K";
        return v == 0 ? "0" : v.ToString("F1");
    }

    private static string Fmt(double v) =>
        v.ToString("F1", System.Globalization.CultureInfo.InvariantCulture);

    private static string LightenHex(string hex, int amt)
    {
        try
        {
            hex = hex.TrimStart('#');
            int r = Math.Min(255, Convert.ToInt32(hex[..2], 16) + amt);
            int g = Math.Min(255, Convert.ToInt32(hex[2..4], 16) + amt);
            int bl = Math.Min(255, Convert.ToInt32(hex[4..6], 16) + amt);
            return $"#{r:X2}{g:X2}{bl:X2}";
        }
        catch { return "#" + hex; }
    }

