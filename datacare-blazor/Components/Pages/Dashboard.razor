@page "/dashboard"
@using DataCareLite.Models
@using DataCareLite.Services
@using Microsoft.Data.SqlClient
@inject EtlStateService State
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>DataCare Dashboard</PageTitle>

@if (!State.HasRun)
{
    <div class="dash-empty">
        <div class="dash-empty-icon">
            <svg viewBox="0 0 64 64" fill="none" width="64" height="64">
                <rect x="4" y="4" width="26" height="26" rx="4" fill="#1a3a6b" opacity=".5" />
                <rect x="34" y="4" width="26" height="26" rx="4" fill="#1a3a6b" opacity=".3" />
                <rect x="4" y="34" width="26" height="26" rx="4" fill="#1a3a6b" opacity=".3" />
                <rect x="34" y="34" width="26" height="26" rx="4" fill="#1a3a6b" opacity=".15" />
            </svg>
        </div>
        <h2 class="dash-empty-title">Nessun dato disponibile</h2>
        <p class="dash-empty-msg">
            Inserisci i valori obbligatori ed esegui il <strong>Run ETL</strong>
            dalla pagina <a href="/">Home</a> per visualizzare la dashboard.
        </p>
    </div>
}
else if (!State.LastRunSuccess)
{
    <div class="dash-error-page">
        <div class="dash-error-icon">&#9888;</div>
        <h2 class="dash-error-title">Ops, errore imprevisto</h2>
        <p class="dash-error-msg">
            Si &egrave; verificato un errore durante l'esecuzione dell'ETL.<br />
            Torna alla pagina <a href="/">Home</a> e riesegui l'ETL.
        </p>
    </div>
}
else if (_loading)
{
    <div class="dash-empty">
        <p class="dash-empty-msg">Caricamento dati dashboard...</p>
    </div>
}
else
{
    <div class="dashboard-page">
        <div class="dash-header">
            <div>
                <h1 class="dash-title">DataCare Dashboard</h1>
                <span class="dash-sub">Microsoft 365 Usage Report</span>
            </div>
            <div class="dept-filter">
                <label class="dept-label">Department</label>
                <select class="dept-select" @bind="_selectedDept" @bind:after="OnDeptChanged">
                    <option value="">All departments</option>
                    @foreach (var d in _departments)
                    {
                        <option value="@d">@d</option>
                    }
                </select>
            </div>
        </div>

        <!-- USERS -->
        <div class="section-band"><span class="section-band-title">Users</span></div>
        <div class="cards-row mb-sm">
            <div class="dcard">
                <div class="dcard-title">Number of users</div>
                @BarChart("users", _data.Select(r => (r.MonthLabel, r.YearNum, (double)r.Users_Total)).ToList(), "#1B8FFF")
            </div>
            <div class="dcard dcard-map">
                <div class="dcard-title">Country Involved</div>
                <div class="country-table-wrap">
                    <table class="ctable">
                        <thead><tr><th>Country</th><th class="ct-num">Count</th></tr></thead>
                        <tbody>
                            @foreach (var c in _countries.Take(10))
                            {
                                <tr><td>@c.CountryName</td><td class="ct-num">@c.CountryCount</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- ONEDRIVE + SHAREPOINT -->
        <div class="two-sections-row mb-sm">
            <div class="section-col">
                <div class="section-band section-band-blue"><span class="section-band-title">OneDrive</span></div>
                <div class="cards-row no-mb">
                    <div class="dcard">
                        <div class="dcard-title">File Count</div>
                        @BarChart("od-fc", _data.Select(r => (r.MonthLabel, r.YearNum, (double)r.OneDrive_Total_File_Count)).ToList(), "#1B8FFF")
                    </div>
                    <div class="dcard">
                        <div class="dcard-title">File Storage (GB)</div>
                        @BarChart("od-gb", _data.Select(r => (r.MonthLabel, r.YearNum, r.OneDrive_Total_StorageUsedGB)).ToList(), "#1B8FFF")
                    </div>
                </div>
            </div>
            <div class="section-col">
                <div class="section-band section-band-teal">
                    <span class="section-badge-sp">S</span>
                    <span class="section-band-title">SharePoint</span>
                </div>
                <div class="cards-row no-mb">
                    <div class="dcard">
                        <div class="dcard-title">File Count</div>
                        @BarChart("sp-fc", _data.Select(r => (r.MonthLabel, r.YearNum, (double)r.SharePoint_Total_File_Count)).ToList(), "#00C9B1")
                    </div>
                    <div class="dcard">
                        <div class="dcard-title">File Storage (GB)</div>
                        @BarChart("sp-gb", _data.Select(r => (r.MonthLabel, r.YearNum, r.SharePoint_Total_StorageUsedGB)).ToList(), "#00C9B1")
                    </div>
                </div>
            </div>
        </div>

        <!-- EXCHANGE -->
        <div class="section-band section-band-dark">
            <span class="section-badge-ex">E</span>
            <span class="section-band-title">Exchange</span>
        </div>
        <div class="cards-row no-mb">
            <div class="dcard">
                <div class="dcard-title">Email Count</div>
                @BarChart("ex-cnt", _data.Select(r => (r.MonthLabel, r.YearNum, (double)r.Exchange_Item_Count)).ToList(), "#1B8FFF")
            </div>
            <div class="dcard">
                <div class="dcard-title">Storage (GB)</div>
                @BarChart("ex-gb", _data.Select(r => (r.MonthLabel, r.YearNum, r.Exchange_StorageUsedGB)).ToList(), "#1B8FFF")
            </div>
            <div class="dcard">
                <div class="dcard-title">Deleted Items</div>
                @GroupedBarChart("ex-del",
                    _data.Select(r => (r.MonthLabel, r.YearNum)).ToList(),
                    new List<(string, Func<DashRow, double>, string)> {
                        ("Count",   r => (double)r.Exchange_Deleted_Item_Count, "#1B8FFF"),
                        ("Size GB", r => r.Exchange_DeletedItemSizeGB,           "#00C9B1"),
                    }, _data)
            </div>
        </div>
    </div>
}

@code {
    private bool _loading = true;
    private List<DashRow> _data = new();
    private List<CountryRow> _countries = new();
    private List<string> _departments = new();
    private string _selectedDept = "";

    protected override async Task OnInitializedAsync()
    {
        State.OnChanged += OnStateChanged;
        if ((State.HasRun && State.LastRunSuccess) || !string.IsNullOrWhiteSpace(State.LastConnectionString))
            await LoadDataAsync();
        else
            _loading = false;
    }

    private async Task LoadDataAsync()
    {
        _loading = true;
        var cs = State.LastConnectionString;
        if (string.IsNullOrWhiteSpace(cs)) { _loading = false; return; }
        try
        {
            await EnsureHistoryPopulatedAsync(cs);
            if (_departments.Count == 0)
                _departments = await QueryListAsync(cs, TableDdl.DepartmentListQuery(), r => r.GetString(0));

            _data = await QueryListAsync(cs, TableDdl.DashboardQuery(_selectedDept), r => new DashRow
            {
                MonthLabel = r.IsDBNull(0) ? "" : r.GetString(0),
                YearNum = r.IsDBNull(1) ? 0 : r.GetInt32(1),
                MonthNum = r.IsDBNull(2) ? 0 : r.GetInt32(2),
                Exchange_Item_Count = r.IsDBNull(3) ? 0 : r.GetInt64(3),
                Exchange_Deleted_Item_Count = r.IsDBNull(4) ? 0 : r.GetInt64(4),
                Exchange_StorageUsedGB = r.IsDBNull(5) ? 0 : (double)r.GetDecimal(5),
                Exchange_DeletedItemSizeGB = r.IsDBNull(6) ? 0 : (double)r.GetDecimal(6),
                OneDrive_Total_File_Count = r.IsDBNull(7) ? 0 : r.GetInt64(7),
                OneDrive_Total_StorageUsedGB = r.IsDBNull(8) ? 0 : (double)r.GetDecimal(8),
                SharePoint_Total_File_Count = r.IsDBNull(9) ? 0 : r.GetInt64(9),
                SharePoint_Total_StorageUsedGB = r.IsDBNull(10) ? 0 : (double)r.GetDecimal(10),
                Users_Total = r.IsDBNull(11) ? 0 : r.GetInt32(11),
            });
            _countries = await QueryListAsync(cs, TableDdl.CountryQuery(_selectedDept), r => new CountryRow
            {
                CountryName = r.IsDBNull(0) ? "Unknown" : r.GetString(0),
                CountryCount = r.IsDBNull(1) ? 0 : r.GetInt32(1),
            });
        }
        catch { }
        finally { _loading = false; }
    }

    private async Task OnDeptChanged() { await LoadDataAsync(); StateHasChanged(); }

    private void OnStateChanged() => _ = InvokeAsync(async () =>
    {
        if (State.HasRun && State.LastRunSuccess) await LoadDataAsync();
        StateHasChanged();
    });

    public void Dispose() => State.OnChanged -= OnStateChanged;

    // ── EnsureHistoryPopulated ────────────────────────────────────────────────
    private static async Task EnsureHistoryPopulatedAsync(string cs)
    {
        await using var conn = new SqlConnection(cs);
        await conn.OpenAsync();
        await using var checkCmd = new SqlCommand(
            "SELECT COUNT(*) FROM INFORMATION_SCHEMA.TABLES WHERE TABLE_NAME='PowerBIDataModelHistory'", conn);
        if ((int)(await checkCmd.ExecuteScalarAsync())! == 0) return;
        await using var countCmd = new SqlCommand("SELECT COUNT(*) FROM dbo.PowerBIDataModelHistory", conn);
        if ((int)(await countCmd.ExecuteScalarAsync())! > 0) return;
        await using var srcCmd = new SqlCommand(
            "SELECT COUNT(*) FROM INFORMATION_SCHEMA.TABLES WHERE TABLE_NAME IN ('MicrosoftExchange','MicrosoftOneDrive','MicrosoftSharePoint','MicrosoftUsers')", conn);
        if ((int)(await srcCmd.ExecuteScalarAsync())! < 4) return;
        var execId = Guid.NewGuid();
        var sql = $"DECLARE @ExecutionId UNIQUEIDENTIFIER = '{execId}';\n" + TableDdl.PowerBIAggregateQuery;
        await using var cmd = new SqlCommand(sql, conn) { CommandTimeout = 180 };
        await cmd.ExecuteNonQueryAsync();
    }

    private static async Task<List<T>> QueryListAsync<T>(string cs, string sql, Func<SqlDataReader, T> map)
    {
        var list = new List<T>();
        await using var conn = new SqlConnection(cs);
        await conn.OpenAsync();
        await using var cmd = new SqlCommand(sql, conn);
        await using var rdr = await cmd.ExecuteReaderAsync();
        while (await rdr.ReadAsync()) list.Add(map(rdr));
        return list;
    }

    // ═════════════════════════════════════════════════════════════════════════
    //  CHART RENDERERS — stile Power BI: barre piene, label sopra, assi puliti
    // ═════════════════════════════════════════════════════════════════════════

    // Dimensioni fisse
    private const int CW = 360, CH = 200;
    private const int PL = 48, PR = 12, PT = 26, PB = 46;   // PT alto per label sopra barre
    private static int PlotW => CW - PL - PR;
    private static int PlotH => CH - PT - PB;

    // ── Single-series bar chart ───────────────────────────────────────────────
    private static RenderFragment BarChart(
        string id,
        List<(string Month, int Year, double Val)> data,
        string color) => b =>
    {
        if (data == null || data.Count == 0) { RenderEmpty(b); return; }

        double max = data.Max(d => d.Val);
        double topVal = NiceTop(max);
        double step = NiceStep(max, 5);
        int n = data.Count;

        // bar geometry
        double slotW = (double)PlotW / n;
        double barW = Math.Max(8, Math.Min(52, slotW * 0.55));

        b.OpenElement(0, "svg");
        b.AddAttribute(1, "viewBox", $"0 0 {CW} {CH}");
        b.AddAttribute(2, "style", "width:100%;height:200px;display:block;");
        b.AddAttribute(3, "xmlns", "http://www.w3.org/2000/svg");

        // gradient def
        RenderGradDef(b, $"g{id}", color);

        // Y grid + labels
        RenderYAxis(b, step, topVal);

        // Bars
        for (int i = 0; i < n; i++)
        {
            double v = data[i].Val;
            double bH = topVal > 0 ? Math.Max(2, v / topVal * PlotH) : 2;
            double bX = PL + slotW * i + (slotW - barW) / 2;
            double bY = PT + PlotH - bH;

            // bar rect
            b.OpenElement(0, "rect");
            b.AddAttribute(0, "x", Fmt(bX));
            b.AddAttribute(0, "y", Fmt(bY));
            b.AddAttribute(0, "width", Fmt(barW));
            b.AddAttribute(0, "height", Fmt(bH));
            b.AddAttribute(0, "rx", "3");
            b.AddAttribute(0, "fill", $"url(#g{id})");
            b.CloseElement();

            // value label above bar
            b.OpenElement(0, "text");
            b.AddAttribute(0, "x", Fmt(bX + barW / 2));
            b.AddAttribute(0, "y", Fmt(bY - 5));
            b.AddAttribute(0, "text-anchor", "middle");
            b.AddAttribute(0, "fill", "#c8daf0");
            b.AddAttribute(0, "font-size", "11");
            b.AddAttribute(0, "font-weight", "600");
            b.AddAttribute(0, "font-family", "'Segoe UI',sans-serif");
            b.AddContent(0, FormatVal(v));
            b.CloseElement();

            // X axis month label
            RenderXLabel(b, bX + barW / 2, data[i].Month, data[i].Year,
                         i == 0 || data[i].Year != data[i - 1].Year);
        }

        // baseline
        RenderBaseline(b);

        b.CloseElement(); // svg
    };

    // ── Grouped bar chart ─────────────────────────────────────────────────────
    private static RenderFragment GroupedBarChart(
        string id,
        List<(string Month, int Year)> labels,
        List<(string Label, Func<DashRow, double> Get, string Color)> series,
        List<DashRow> rows) => b =>
    {
        if (rows == null || rows.Count == 0) { RenderEmpty(b); return; }

        int n = rows.Count;
        int s = series.Count;
        double max = rows.SelectMany(r => series.Select(sv => sv.Get(r))).DefaultIfEmpty(1).Max();
        double topVal = NiceTop(max);
        double step = NiceStep(max, 5);

        double slotW = (double)PlotW / n;
        double gap = 3;
        double barW = Math.Max(5, Math.Min(30, (slotW * 0.7 - gap * (s - 1)) / s));
        double groupUsed = barW * s + gap * (s - 1);

        b.OpenElement(0, "svg");
        b.AddAttribute(1, "viewBox", $"0 0 {CW} {CH}");
        b.AddAttribute(2, "style", "width:100%;height:200px;display:block;");
        b.AddAttribute(3, "xmlns", "http://www.w3.org/2000/svg");

        // gradient defs per series
        for (int si = 0; si < s; si++)
            RenderGradDef(b, $"gg{id}{si}", series[si].Color);

        // legend top-right
        double legX = CW - PR - (s * 70);
        for (int si = 0; si < s; si++)
        {
            b.OpenElement(0, "rect");
            b.AddAttribute(0, "x", Fmt(legX + si * 70)); b.AddAttribute(0, "y", "6");
            b.AddAttribute(0, "width", "10"); b.AddAttribute(0, "height", "10");
            b.AddAttribute(0, "rx", "2"); b.AddAttribute(0, "fill", series[si].Color);
            b.CloseElement();
            b.OpenElement(0, "text");
            b.AddAttribute(0, "x", Fmt(legX + si * 70 + 14)); b.AddAttribute(0, "y", "15");
            b.AddAttribute(0, "fill", "#8ab0d0"); b.AddAttribute(0, "font-size", "10");
            b.AddAttribute(0, "font-family", "'Segoe UI',sans-serif");
            b.AddContent(0, series[si].Label);
            b.CloseElement();
        }

        RenderYAxis(b, step, topVal);

        for (int i = 0; i < n; i++)
        {
            double gX = PL + slotW * i + (slotW - groupUsed) / 2;

            for (int si = 0; si < s; si++)
            {
                double v = series[si].Get(rows[i]);
                double bH = topVal > 0 ? Math.Max(2, v / topVal * PlotH) : 2;
                double bX = gX + si * (barW + gap);
                double bY = PT + PlotH - bH;

                b.OpenElement(0, "rect");
                b.AddAttribute(0, "x", Fmt(bX));
                b.AddAttribute(0, "y", Fmt(bY));
                b.AddAttribute(0, "width", Fmt(barW));
                b.AddAttribute(0, "height", Fmt(bH));
                b.AddAttribute(0, "rx", "2");
                b.AddAttribute(0, "fill", $"url(#gg{id}{si})");
                b.CloseElement();
            }

            RenderXLabel(b, gX + groupUsed / 2, labels[i].Month, labels[i].Year,
                         i == 0 || labels[i].Year != labels[i - 1].Year);
        }

        RenderBaseline(b);
        b.CloseElement();
    };

    // ── Shared SVG helpers ────────────────────────────────────────────────────

    private static void RenderGradDef(
        Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder b,
        string gid, string color)
    {
        // top color = color slightly lighter, bottom = color itself (solid, no transparency)
        string top = LightenHex(color, 50);
        b.OpenElement(0, "defs");
        b.OpenElement(0, "linearGradient");
        b.AddAttribute(0, "id", gid);
        b.AddAttribute(0, "x1", "0"); b.AddAttribute(0, "y1", "0");
        b.AddAttribute(0, "x2", "0"); b.AddAttribute(0, "y2", "1");
        b.OpenElement(0, "stop");
        b.AddAttribute(0, "offset", "0%");
        b.AddAttribute(0, "stop-color", top);
        b.AddAttribute(0, "stop-opacity", "1");
        b.CloseElement();
        b.OpenElement(0, "stop");
        b.AddAttribute(0, "offset", "100%");
        b.AddAttribute(0, "stop-color", color);
        b.AddAttribute(0, "stop-opacity", "1");
        b.CloseElement();
        b.CloseElement(); // linearGradient
        b.CloseElement(); // defs
    }

    private static void RenderYAxis(
        Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder b,
        double step, double topVal)
    {
        var ticks = new List<double>();
        for (double t = 0; t <= topVal + step * 0.01; t += step) ticks.Add(t);

        foreach (var t in ticks)
        {
            double yp = PT + PlotH - (topVal > 0 ? t / topVal * PlotH : 0);

            b.OpenElement(0, "line");
            b.AddAttribute(0, "x1", PL.ToString()); b.AddAttribute(0, "y1", Fmt(yp));
            b.AddAttribute(0, "x2", (CW - PR).ToString()); b.AddAttribute(0, "y2", Fmt(yp));
            b.AddAttribute(0, "stroke", t == 0 ? "#2a3a55" : "#1c2538");
            b.AddAttribute(0, "stroke-width", t == 0 ? "1.2" : "0.7");
            b.AddAttribute(0, "stroke-dasharray", t == 0 ? "" : "4 3");
            b.CloseElement();

            b.OpenElement(0, "text");
            b.AddAttribute(0, "x", (PL - 6).ToString());
            b.AddAttribute(0, "y", Fmt(yp + 4));
            b.AddAttribute(0, "text-anchor", "end");
            b.AddAttribute(0, "fill", "#6a8aaa");
            b.AddAttribute(0, "font-size", "10");
            b.AddAttribute(0, "font-family", "'Segoe UI',ui-monospace,monospace");
            b.AddContent(0, FormatVal(t));
            b.CloseElement();
        }
    }

    private static void RenderBaseline(
        Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder b)
    {
        b.OpenElement(0, "line");
        b.AddAttribute(0, "x1", PL.ToString()); b.AddAttribute(0, "y1", (PT + PlotH).ToString());
        b.AddAttribute(0, "x2", (CW - PR).ToString()); b.AddAttribute(0, "y2", (PT + PlotH).ToString());
        b.AddAttribute(0, "stroke", "#2a3a55"); b.AddAttribute(0, "stroke-width", "1.5");
        b.CloseElement();
    }

    private static void RenderXLabel(
        Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder b,
        double cx, string month, int year, bool showYear)
    {
        int baseLine = PT + PlotH;

        // month abbreviation
        b.OpenElement(0, "text");
        b.AddAttribute(0, "x", Fmt(cx));
        b.AddAttribute(0, "y", (baseLine + 16).ToString());
        b.AddAttribute(0, "text-anchor", "middle");
        b.AddAttribute(0, "fill", "#8ab0cc");
        b.AddAttribute(0, "font-size", "11");
        b.AddAttribute(0, "font-family", "'Segoe UI',sans-serif");
        b.AddContent(0, month.Length > 3 ? month[..3] : month);
        b.CloseElement();

        // year (only when it changes)
        if (showYear)
        {
            b.OpenElement(0, "text");
            b.AddAttribute(0, "x", Fmt(cx));
            b.AddAttribute(0, "y", (baseLine + 30).ToString());
            b.AddAttribute(0, "text-anchor", "middle");
            b.AddAttribute(0, "fill", "#4a6a88");
            b.AddAttribute(0, "font-size", "10");
            b.AddAttribute(0, "font-weight", "600");
            b.AddAttribute(0, "font-family", "'Segoe UI',sans-serif");
            b.AddContent(0, year.ToString());
            b.CloseElement();
        }
    }

    private static void RenderEmpty(
        Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder b)
    {
        b.OpenElement(0, "div");
        b.AddAttribute(1, "class", "ch-empty");
        b.AddContent(2, "Nessun dato");
        b.CloseElement();
    }

    // ── Maths ─────────────────────────────────────────────────────────────────
    private static double NiceTop(double max)
    {
        if (max <= 0) return 1;
        double step = NiceStep(max, 5);
        return step * Math.Ceiling(max / step);
    }

    private static double NiceStep(double max, int ticks)
    {
        if (max <= 0) return 1;
        double raw = max / ticks;
        double mag = Math.Pow(10, Math.Floor(Math.Log10(raw)));
        foreach (var n in new[] { 1.0, 2, 2.5, 5, 10 })
            if (n * mag >= raw) return n * mag;
        return 10 * mag;
    }

    private static string FormatVal(double v)
    {
        if (v >= 1_000_000_000) return $"{v / 1_000_000_000:F2}Mld";
        if (v >= 1_000_000) return $"{v / 1_000_000:F2}Mln";
        if (v >= 1_000) return $"{v / 1_000:F1}K";
        return v == 0 ? "0" : v.ToString("F1");
    }

    private static string Fmt(double v) => v.ToString("F1", System.Globalization.CultureInfo.InvariantCulture);

    private static string LightenHex(string hex, int amt)
    {
        try
        {
            hex = hex.TrimStart('#');
            int r = Math.Min(255, Convert.ToInt32(hex[..2], 16) + amt);
            int g = Math.Min(255, Convert.ToInt32(hex[2..4], 16) + amt);
            int bl = Math.Min(255, Convert.ToInt32(hex[4..6], 16) + amt);
            return $"#{r:X2}{g:X2}{bl:X2}";
        }
        catch { return "#" + hex; }
    }

    // ── Models ────────────────────────────────────────────────────────────────
    private class DashRow
    {
        public string MonthLabel { get; set; } = "";
        public int YearNum { get; set; }
        public int MonthNum { get; set; }
        public long Exchange_Item_Count { get; set; }
        public long Exchange_Deleted_Item_Count { get; set; }
        public double Exchange_StorageUsedGB { get; set; }
        public double Exchange_DeletedItemSizeGB { get; set; }
        public long OneDrive_Total_File_Count { get; set; }
        public double OneDrive_Total_StorageUsedGB { get; set; }
        public long SharePoint_Total_File_Count { get; set; }
        public double SharePoint_Total_StorageUsedGB { get; set; }
        public int Users_Total { get; set; }
    }

    private class CountryRow
    {
        public string CountryName { get; set; } = "";
        public int CountryCount { get; set; }
    }
}

<style>
    /* ── Layout ──────────────────────────────────────────────────────────────── */
    .dashboard-page { padding:1.5rem 2rem; }
    .dash-header    { display:flex; align-items:flex-start; justify-content:space-between;
                      flex-wrap:wrap; gap:1rem; margin-bottom:1rem; }
    .dash-title     { font-size:1.45rem; font-weight:700; color:#c8daf0; margin:0; }
    .dash-sub       { font-size:.78rem; color:#4a6a88; }

    /* dept filter */
